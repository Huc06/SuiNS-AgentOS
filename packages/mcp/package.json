  },
  "dependencies": {
    "@agentos/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
