# --- Frontend (public — safe in browser) ---
# Enoki zkLogin (issue #11): Public key from https://portal.enoki.mystenlabs.com
# NEXT_PUBLIC_ENOKI_API_KEY=enoki_public_xxxxxxxx

# Optional: only if Google OAuth is NOT configured in Enoki Portal
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Sui network for dapp-kit + sponsor API
# NEXT_PUBLIC_SUI_NETWORK=testnet

# After contracts publish — wallet-paid on-chain mint from /create
# NEXT_PUBLIC_AGENTOS_PACKAGE_ID=0x...

# Optional: Enoki sponsor instead of wallet gas (default off)
# NEXT_PUBLIC_ENOKI_SPONSOR=true

# AgentOS dashboard URL (links from CLI)
# NEXT_PUBLIC_DASHBOARD_URL=https://agentos.example.com

# --- Server-only (API routes — never NEXT_PUBLIC_) ---
# Enoki sponsored tx backend route (private key — GitHub/Cloudflare secrets only)
# ENOKI_SECRET_KEY=enoki_private_xxxxxxxx

# Local registry path override (optional)
# AGENTOS_REGISTRY_PATH=.agentos/registry.json

# After contracts publish (epic #6)
# AGENTOS_PACKAGE_ID=0x...
