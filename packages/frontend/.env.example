# =============================================================================
# AgentOS frontend (Next.js) — copy to `.env` and fill in. NEVER commit `.env`.
# NEXT_PUBLIC_* values are inlined into the browser bundle (safe to expose).
# Everything else is server-only (API routes) — keep it secret.
# =============================================================================

# --- Public (browser-safe) ---------------------------------------------------

# Sui network for dapp-kit + sponsored tx. One of: testnet | mainnet | devnet.
NEXT_PUBLIC_SUI_NETWORK=testnet

# Sui fullnode RPC URL override. REQUIRED as of 2026 — Sui's public JSON-RPC
# endpoints (fullnode.{network}.sui.io) are being shut down network-by-network
# (testnet cutover began the week of 2026-07-06, full deactivation 2026-07-31;
# see docs.sui.io/develop/accessing-data/json-rpc-migration). Without this set,
# every on-chain call (wallet connect, sponsored execution, workflow runs)
# silently fails with "Unexpected status code: 404". Set to a still-live
# JSON-RPC provider, e.g. a free PublicNode endpoint:
NEXT_PUBLIC_SUI_RPC_URL=https://sui-testnet-rpc.publicnode.com

# Published AgentOS Move package id. When set, create-agent mints a real
# on-chain AgentPassport; when unset, agents are registry-only (no chain).
# NEXT_PUBLIC_AGENTOS_PACKAGE_ID=0x...

# Google OAuth client id for Enoki zkLogin (only if not configured in the Enoki Portal).
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Optional: Enoki *public* key, only needed for browser-wallet zkLogin flows.
# Server-side gasless minting does NOT need this (it uses ENOKI_SECRET_KEY).
# NEXT_PUBLIC_ENOKI_API_KEY=enoki_public_xxxxxxxx

# Optional client flag for the legacy browser-wallet sponsor path (default off).
# NEXT_PUBLIC_ENOKI_SPONSOR=true

# Enoki gas sponsorship is NOT supported on mainnet by this deployment (no
# mainnet Enoki billing/sponsor budget is configured — see
# docs/setup-env-auth-deploy.md). On mainnet, sponsorship is disabled by
# default and the app falls back to the user's own wallet paying gas. If you
# have set up real mainnet Enoki billing yourself, opt back in with BOTH:
# NEXT_PUBLIC_ENOKI_ALLOW_MAINNET=true
# (and, server-side below:) ENOKI_ALLOW_MAINNET=true

# Optional: AgentOS dashboard URL (links rendered by the CLI).
# NEXT_PUBLIC_DASHBOARD_URL=https://agentos.example.com

# --- Server-only (API routes — NEVER prefix with NEXT_PUBLIC_) ----------------

# Enoki *secret* key. Used by the API routes to sponsor gas for transactions.
# Get it from https://portal.enoki.mystenlabs.com. Store as a deployment secret.
ENOKI_SECRET_KEY=enoki_private_xxxxxxxx

# See NEXT_PUBLIC_ENOKI_ALLOW_MAINNET above — sponsoredExecuteServer() (used by
# the workflow run route) refuses to sponsor on mainnet unless this is ALSO
# set to true. Both flags exist because the client-side mint flow and the
# server-side workflow-run path are gated independently.
# ENOKI_ALLOW_MAINNET=true

# Sui private key (suiprivkey1...) of the server runtime wallet. This wallet is
# the SENDER of gasless transactions (Enoki pays the gas). It signs the
# AgentPassport mint. Keep it secret; rotate if leaked.
SUI_PRIVATE_KEY=suiprivkey1xxxxxxxx

# Server-side package id fallback (used if NEXT_PUBLIC_AGENTOS_PACKAGE_ID is unset).
# AGENTOS_PACKAGE_ID=0x...

# Server-side RPC URL override (used by API routes — run/route.ts, resolve/route.ts,
# sponsored-execute.ts). Same 2026 JSON-RPC deprecation applies server-side; set
# this to the same value as NEXT_PUBLIC_SUI_RPC_URL above if it's not already set.
SUI_RPC_URL=https://sui-testnet-rpc.publicnode.com

# Optional: override the local registry path (defaults to repo-root .agentos/registry.json).
# AGENTOS_REGISTRY_PATH=.agentos/registry.json

# Storage backend for the deployed app's registry + runs (see docs/storage-adapter.md).
#   file     (default) — file-backed, atomic + race-free; the shared .agentos/ files.
#            On Vercel this is `/tmp`, which is PER SERVERLESS INSTANCE — a
#            publish/write can land on an instance a later request never
#            reaches, causing real data loss (a workflow reverting to a stale
#            or blank draft on refresh). Fine for local dev; NOT safe for a
#            multi-instance production deploy.
#   memory             — ephemeral in-memory (read-only serverless fs; tests)
#   postgres           — Neon / Vercel Postgres. Real shared state across every
#            instance — the only backend that is actually correct on Vercel.
#            Requires DATABASE_URL (or POSTGRES_URL) below, and running
#            scripts/schema.sql against the database once before first use.
#            To migrate existing `.agentos/registry.json` data, run
#            `cd packages/frontend && npx tsx ../../scripts/migrate-to-postgres.ts`.
# STORAGE_BACKEND=file

# Postgres connection string (Neon / Vercel Postgres). Required when
# STORAGE_BACKEND=postgres. Get it from the Neon console (Connection Details)
# or Vercel's Storage tab (Create Database → Neon), which sets this
# automatically for you.
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# --- Walrus aggregator (read path for skill/workflow manifest blobs) ---------
# Used by /api/skills/blob-status (and the SDK's WalrusClient default) to check
# whether a manifest blob is reachable. Defaults to the public TESTNET
# aggregator — there is no public unauthenticated Walrus aggregator/publisher
# on mainnet (see packages/sdk/src/walrus.ts). Override with your own
# authenticated aggregator (or an Upload Relay-fronted one) for mainnet:
# WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# --- Harbor (real Walrus Harbor storage for private skills) -------------------
# When HARBOR_API_KEY + HARBOR_SPACE_ID are set, the workflow "Harbor" step
# Seal-encrypts a private skill and uploads the ciphertext to your REAL Walrus
# Harbor account (api.testnet.harbor.walrus.xyz) — the blob then appears in your
# Harbor space. Unset → the step still runs (uploads to Walrus) but the blob does
# NOT land in a Harbor account. HARBOR_BUCKET_ID must be a bucket UUID.
# HARBOR_API_KEY=harbor_xxxxxxxx
# HARBOR_SPACE_ID=...
# HARBOR_BUCKET_ID=00000000-0000-4000-8000-000000000001
# Harbor is testnet-only — there is no known mainnet Harbor gateway. Override
# only if you're pointing at a self-hosted/alternate gateway (defaults to
# https://api.testnet.harbor.walrus.xyz):
# HARBOR_BASE_URL=https://api.testnet.harbor.walrus.xyz

# --- Memwal (Walrus Memory — Walrus-backed agent memory) ----------------------
# Relayer the workflow run route writes to via the "Memory" step
# (POST /api/remember, /api/recall). The REAL Walrus Memory relayer authenticates
# with SIGNED Ed25519 headers derived from a MemWalAccount delegate key — NOT a
# bearer token, and NOT your SUI_PRIVATE_KEY (a delegate key must be generated
# and registered on your account; it cannot be an arbitrary key).
#
# 1. Go to https://memory.walrus.xyz and sign in.
# 2. Copy the Account ID shown on the dashboard into MEMWAL_ACCOUNT_ID.
# 3. Click "Add key" to generate + auto-register a delegate key. Copy its
#    PRIVATE key into MEMWAL_DELEGATE_KEY (shown once — save it immediately).
# 4. The dashboard's generated key is for the PRODUCTION relayer — set
#    MEMWAL_RELAYER_URL to https://relayer.memory.walrus.xyz (below).
# The memory step is skipped (and the run still succeeds) when these are unset.
# MEMWAL_ACCOUNT_ID=0xYOUR_MEMWAL_ACCOUNT_ID
# MEMWAL_DELEGATE_KEY=YOUR_DELEGATE_ED25519_PRIVATE_KEY_HEX
# Relayer URL: production (matches the dashboard-generated key above).
# MEMWAL_RELAYER_URL=https://relayer.memory.walrus.xyz
# For testnet/staging (relayer-staging.memory.walrus.xyz), the delegate key must
# be generated for that network specifically — a production dashboard key will
# NOT authenticate against staging (401 AUTH_REJECTED), and vice versa.
# Docs: https://docs.wal.app/walrus-memory/relayer/public-relayer
# Troubleshooting 401s: https://docs.wal.app/walrus-memory/troubleshooting/overview
# (Legacy bearer scheme — MEMWAL_API_KEY — is NOT used by the official relayer;
# retained only for a custom/self-hosted relayer that still accepts a bearer
# token. Prefer the signed scheme above.)
