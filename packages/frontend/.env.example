# =============================================================================
# AgentOS frontend (Next.js) — copy to `.env` and fill in. NEVER commit `.env`.
# NEXT_PUBLIC_* values are inlined into the browser bundle (safe to expose).
# Everything else is server-only (API routes) — keep it secret.
# =============================================================================

# --- Public (browser-safe) ---------------------------------------------------

# Sui network for dapp-kit + sponsored tx. One of: testnet | mainnet | devnet.
NEXT_PUBLIC_SUI_NETWORK=testnet

# Published AgentOS Move package id. When set, create-agent mints a real
# on-chain AgentPassport; when unset, agents are registry-only (no chain).
# NEXT_PUBLIC_AGENTOS_PACKAGE_ID=0x...

# Google OAuth client id for Enoki zkLogin (only if not configured in the Enoki Portal).
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Optional: Enoki *public* key, only needed for browser-wallet zkLogin flows.
# Server-side gasless minting does NOT need this (it uses ENOKI_SECRET_KEY).
# NEXT_PUBLIC_ENOKI_API_KEY=enoki_public_xxxxxxxx

# Optional client flag for the legacy browser-wallet sponsor path (default off).
# NEXT_PUBLIC_ENOKI_SPONSOR=true

# Optional: AgentOS dashboard URL (links rendered by the CLI).
# NEXT_PUBLIC_DASHBOARD_URL=https://agentos.example.com

# --- Server-only (API routes — NEVER prefix with NEXT_PUBLIC_) ----------------

# Enoki *secret* key. Used by the API routes to sponsor gas for transactions.
# Get it from https://portal.enoki.mystenlabs.com. Store as a deployment secret.
ENOKI_SECRET_KEY=enoki_private_xxxxxxxx

# Sui private key (suiprivkey1...) of the server runtime wallet. This wallet is
# the SENDER of gasless transactions (Enoki pays the gas). It signs the
# AgentPassport mint. Keep it secret; rotate if leaked.
SUI_PRIVATE_KEY=suiprivkey1xxxxxxxx

# Server-side package id fallback (used if NEXT_PUBLIC_AGENTOS_PACKAGE_ID is unset).
# AGENTOS_PACKAGE_ID=0x...

# Optional: override the local registry path (defaults to repo-root .agentos/registry.json).
# AGENTOS_REGISTRY_PATH=.agentos/registry.json

# --- Harbor (Seal-encrypted Walrus storage for private skills) ----------------
# HARBOR_API_KEY=harbor_xxxxxxxx
# HARBOR_BUCKET_ID=...
# HARBOR_SPACE_ID=...

# --- Memwal (Walrus-backed agent memory) --------------------------------------
# Relayer the workflow run route writes to via the "Memory" step
# (POST /remember, /recall). Both must be set to enable memory; if either is
# unset, the memory step is skipped and the run still succeeds.
# MEMWAL_RELAYER_URL=https://relayer.memwal.example
# MEMWAL_API_KEY=memwal_xxxxxxxx
