{
  "name": "@agentos/sdk",
  "version": "0.0.1",
  "description": "TypeScript SDK for SuiNS AgentOS — Sui-native identity, skill discovery, and delegation for AI agents",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Huc06/SuiNS-AgentOS.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/Huc06/SuiNS-AgentOS#readme",
  "bugs": {
    "url": "https://github.com/Huc06/SuiNS-AgentOS/issues"
  },
  "keywords": [
    "sui",
    "suins",
    "agent",
    "ai-agent",
    "walrus",
    "move",
    "web3",
    "sdk"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "codegen": "echo 'Run sui codegen after @mysten/codegen is configured for packages/contracts'"
  },
  "peerDependencies": {
    "@mysten/dapp-kit": "^0.14.0",
    "@mysten/seal": "^0.1.0",
    "@mysten/sui": "^1.0.0",
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@mysten/dapp-kit": {
      "optional": true
    },
    "@mysten/seal": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mysten/dapp-kit": "^0.14.0",
    "@mysten/seal": "^0.1.0",
    "@mysten/sui": "^1.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "fast-check": "^4.8.0",
    "react": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
