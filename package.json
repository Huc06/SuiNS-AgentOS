{
  "name": "agentos",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "publish:sdk": "pnpm --filter @agentos/sdk publish --no-git-checks",
    "publish:mcp": "pnpm --filter @agentos/mcp publish --no-git-checks",
    "publish:all": "pnpm publish -r --no-git-checks --filter '@agentos/sdk' --filter '@agentos/mcp'",
    "version:patch": "pnpm --filter '@agentos/sdk' --filter '@agentos/mcp' exec npm version patch --no-git-tag-version",
    "version:minor": "pnpm --filter '@agentos/sdk' --filter '@agentos/mcp' exec npm version minor --no-git-tag-version",
    "version:major": "pnpm --filter '@agentos/sdk' --filter '@agentos/mcp' exec npm version major --no-git-tag-version",
    "seed": "npx tsx scripts/seed-testnet.ts",
    "demo": "npx tsx scripts/seed-testnet.ts && echo '\\n🎬 Demo URLs:' && echo ' / — Landing (Hero + Search)' && echo ' /explore — Public Agent Directory' && echo ' /create — Dashboard (Create Agent)' && echo ' /agent/alpha — Agent Profile' && echo ' /agent/alpha/skills — Skill Console' && echo ' /agent/alpha/delegate — Delegation UI'",
    "contracts:build": "cd packages/contracts && sui move build",
    "contracts:test": "cd packages/contracts && sui move test",
    "contracts:publish": "cd packages/contracts && sui client publish",
    "agentos": "node packages/cli/dist/agentos.js"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "tsx": "^4.22.4",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
