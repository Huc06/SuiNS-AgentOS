# =============================================================================
# SuiNS AgentOS — root environment template. Copy to `.env` and fill in.
# NEVER commit `.env` (it is gitignored). NEVER put real secrets in this file.
#
# Consumed by: CLI (`agentos`), MCP server, and the Next.js dashboard.
# `NEXT_PUBLIC_*` values are inlined into the browser bundle (safe to expose);
# everything else is server-only and must stay secret.
# =============================================================================

# --- Sui network -------------------------------------------------------------

# Network for dapp-kit, the SDK, and sponsored transactions: testnet | mainnet | devnet.
NEXT_PUBLIC_SUI_NETWORK=testnet

# Optional client-visible RPC override. The dashboard falls back to PublicNode
# for testnet/mainnet because Sui's legacy fullnode URLs were retired in 2026.
# Set this for a provider you operate or trust in production.
# NEXT_PUBLIC_SUI_RPC_URL=https://sui-testnet-rpc.publicnode.com

# --- On-chain package --------------------------------------------------------

# Published AgentOS Move package id. When set, agent/skill operations run
# on-chain; when unset, the SDK falls back to the local registry (dev, no gas).
# Both names are read (NEXT_PUBLIC_ wins); set whichever your surface needs.
# NEXT_PUBLIC_AGENTOS_PACKAGE_ID=0x...
# AGENTOS_PACKAGE_ID=0x...

# --- Gasless minting (Enoki sponsorship + server runtime keypair) ------------

# Enoki SECRET key — sponsors gas for server-side transactions (API routes).
# Get it from https://portal.enoki.mystenlabs.com. Deployment secret only.
ENOKI_SECRET_KEY=enoki_private_xxxxxxxx

# Sui private key (suiprivkey1...) of the server runtime wallet. This wallet is
# the SENDER of gasless transactions (Enoki pays the gas) and signs the
# AgentPassport mint. Keep it secret; rotate immediately if leaked.
SUI_PRIVATE_KEY=suiprivkey1xxxxxxxx

# --- Enoki zkLogin (browser wallets, optional) -------------------------------

# Enoki PUBLIC key (browser-safe) for zkLogin wallets. Not needed for the
# server-side gasless mint path, which uses ENOKI_SECRET_KEY + SUI_PRIVATE_KEY.
# NEXT_PUBLIC_ENOKI_API_KEY=enoki_public_xxxxxxxx

# Google OAuth client id for Enoki zkLogin (only if not set in the Enoki Portal).
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# --- Harbor (Seal-encrypted Walrus storage for private skills) ---------------
# HARBOR_API_KEY=hbr_xxxxxxxx
# HARBOR_SERVICE_PRIVKEY=suiprivkey1xxxxxxxx # reserve/finalize/decrypt only
# HARBOR_BUCKET_ID=00000000-0000-4000-8000-000000000001
# HARBOR_SPACE_ID=...
# HARBOR_SEAL_POLICY_ID=0x... # active private bucket policy

# --- Local registry (dev) ----------------------------------------------------
# Override the local registry path (defaults to repo-root .agentos/registry.json).
# AGENTOS_REGISTRY_PATH=.agentos/registry.json

# --- Memwal (Walrus Memory — Walrus-backed agent memory) ---------------------
# Relayer that the workflow "Memory" step writes to (POST /api/remember,
# /api/recall). The REAL Walrus Memory relayer authenticates with SIGNED Ed25519
# headers derived from a MemWalAccount delegate key — NOT a bearer token. Set
# BOTH of these (the official signed scheme):
#   MEMWAL_ACCOUNT_ID   — your MemWalAccount object id (0x…)
#   MEMWAL_DELEGATE_KEY — the delegate Ed25519 PRIVATE key (32-byte hex seed, or
#                         a suiprivkey1… string). KEEP SECRET — never commit.
# Generate both at the Walrus Memory Playground: https://memory.walrus.xyz
# Both must be set to enable memory; if either is unset, the memory step is
# skipped (the workflow run never fails on a missing relayer).
# MEMWAL_ACCOUNT_ID=0xYOUR_MEMWAL_ACCOUNT_ID
# MEMWAL_DELEGATE_KEY=YOUR_DELEGATE_ED25519_PRIVATE_KEY_HEX
# Relayer URL is OPTIONAL — defaults to the Walrus Foundation hosted TESTNET
# relayer (https://relayer-staging.memory.walrus.xyz). For mainnet, override:
# MEMWAL_RELAYER_URL=https://relayer.memory.walrus.xyz
# Docs: https://docs.wal.app/walrus-memory/relayer/public-relayer
# (Legacy bearer scheme — MEMWAL_API_KEY — is NOT used by the official relayer;
# it is retained only for a custom/self-hosted relayer that still accepts a
# bearer token. Prefer the signed scheme above.)
